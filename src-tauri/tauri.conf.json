{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "OJ Insight",
  "version": "0.8.0",
  "identifier": "com.ojinsight.app",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "OJ Insight",
        "width": 1380,
        "height": 860,
        "minWidth": 1040,
        "minHeight": 680,
        "resizable": true,
        "fullscreen": false,
        "center": true,
        "decorations": true,
        "create": false
      }
    ],
    "security": {
      "csp": "default-src 'self'; connect-src ipc: http://ipc.localhost; img-src 'self' asset: http://asset.localhost data:; style-src 'self' 'unsafe-inline'"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "targets": "all",
    "shortDescription": "Unified competitive programming analytics",
    "longDescription": "Aggregate, analyze and visualize activity from multiple online judges.",
    "windows": {
      "webviewInstallMode": {
        "type": "downloadBootstrapper",
        "silent": true
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "macOS": {
      "minimumSystemVersion": "11.0"
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaW5pIHB1YmxpYyBrZXk6IDM1REExMDU2MzcyQzI0N0UKUldSK0pDdzNWaERhTllsY3NybDhOeDE4ejVYUTMxSW9zZlBTaWZlTldSdlcvSDBldDY4aXl4ZnkK",
      "endpoints": [
        "https://github.com/Whalica/OJ_Insight/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
